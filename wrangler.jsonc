{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-bookmark",
  "compatibility_date": "2026-10-29",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-bookmark-db",
      "database_id": "e662fca5-4b35-460f-b2a1-5577fa7c23b0",
      "migrations_dir": "migrations"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "cloud-bookmark-db",
        "database_id": "e662fca5-4b35-460f-b2a1-5577fa7c23b0"
      }
    ]
  }
}
